{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "automerge": false,
    "extends": [
        "config:recommended",
        ":dependencyDashboard"
    ],
    "semanticCommits": "enabled",
    "platform": "github",
    "autodiscover": true,
    "autodiscoverFilter": [
        "cmacsithigh/*"
    ],
    "labels": [
        "renovate"
    ],
    "repositoryCache": "enabled",
    "enabledManagers": [
        "dockerfile",
        "docker-compose",
        "github-actions",
        "helmfile",
        "crossplane",
        "azure-pipelines",
        "nuget",
        "helmv3",
        "helm-values",
        "kubernetes",
        "kustomize",
        "npm",
        "custom.regex",
        "terraform",
        "flux"
    ],
    "prBodyTemplate": "{{{header}}}{{{table}}}{{{warnings}}}{{{notes}}}{{{changelogs}}}",
    "prHourlyLimit": 0,
    "git-submodules": {
        "enabled": true
    },
    "kubernetes": {
        "managerFilePatterns": ["/^.*\\.yaml$/"]
    },
    "kustomize": {
        "managerFilePatterns": ["/^.*\\.yaml$/"]
    },
    "flux": {
        "managerFilePatterns": ["/^.*\\.yaml$/"]
    },
    "helm-values": {
        "managerFilePatterns": ["/^.*\\.yaml$/"]
    },
    "helmv3": {
        "managerFilePatterns": ["/^.*\\.yaml$/"]
    },
    "helmfile": {
        "managerFilePatterns": ["/^.*\\.yaml$/"]
    },
    "packageRules": [
        {
            "description": "Automerge all non-major Docker image updates",
            "matchDatasources": ["docker"],
            "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
            "automerge": true,
            "platformAutomerge": true
        },
        {
            "description": "Never automerge major Docker updates",
            "matchDatasources": ["docker"],
            "matchUpdateTypes": ["major"],
            "automerge": false
        }
    ]
}
